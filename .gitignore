# Virtual environment
venv/

# Environment variables
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# Model artifacts (large files)
model/*/model.pkl
model/*/*.json
model/*/*.pkl

# ...except the production risk model(s), which are committed so git-triggered
# Cloud Build can COPY them into the image (see Dockerfile). app.py prefers the
# newest model/risk_* dir. Keep this allowlist so retrained risk models ship.
!model/risk_*/model.pkl

# IDE
.vscode/
.idea/

# OS
.DS_Store
